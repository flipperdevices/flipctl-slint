// The panel's three fonts, and their family names.
//
// Imported for the side effect: a `.ttf` import registers the face with the
// compilation unit that reaches it, so whichever entry file a consumer compiles has
// to reach this one. They used to live in statusbar.slint, which every screen of
// flipctl's has on it -- and which a consumer drawing a single screen does not,
// leaving it to fall back to a system font that is not a pixel font at all. Now any
// entry can import the names below and get the faces with them.
//
// They are pixel fonts on a 64-unit design-pixel grid at 1024 units/em, so they
// rasterise with zero partial coverage at 16px and only at 16px. Font size is
// therefore never a free parameter.
import "../../../third_party/flipctl-fonts/HaxrCorp4090-FlipCTL/HaxrCorp4090-FlipCTL.ttf";
import "../../../third_party/flipctl-fonts/Busy9px-FlipCTL/Busy9px-FlipCTL.ttf";
import "../../../third_party/flipctl-fonts/Born2bSportyV2-FlipCTL/Born2bSportyV2-FlipCTL.ttf";

// The family names, which are the only thing a `font-family` may be set to: the
// full name ("HaxrCorp 4090 FlipCTL") does not resolve, and getting it wrong shows
// as a fallback font rather than as an error.
export global PanelFonts {
    out property <string> title: "HaxrCorp 4090";
    out property <string> row: "Busy9px";
    out property <string> row_active: "Born2bSportyV2";
}
