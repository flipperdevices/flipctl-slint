// A settings row laid out for a portrait page, 144 across - a fixture for
// `tests/portrait_ui.rs`, not a component flipctl draws.
//
// What it is for: the framework's row components measure their chip from
// `tokens.toml`, which is the panel's, so a portrait page has to pass its own
// width. This is the smallest thing that proves a row can be built for a
// narrower window and turned onto the panel afterwards - the two halves of a
// portrait screen that were missing.
//
// It lives next to the test that renders it because nothing else uses it:
// compiled through `ui/screens.slint` it was a test fixture inside the production
// module, drawn by flipctl and never called. `build.rs` compiles this file on its
// own and the test includes the result by path.
import { FlipperTheme } from "@theme";
import { DropLine, DropRow } from "../ui/dropdown.slint";
import { SelectorFrame } from "../ui/frame.slint";

export { DropRow }

export component PortraitRow inherits Window {
    // The panel read the long way up: the theme's two numbers, swapped.
    width: FlipperTheme.panel_h;
    height: FlipperTheme.panel_w;
    background: FlipperTheme.white;

    // The row the app would build in Rust and hand over.
    in property <DropRow> line;

    // The chip's width on a page this narrow. A portrait page is `panel_h` across, and a
    // chip measured from the panel is 180 wide - wider than the page itself - so the caller
    // brings the page's own number. The theme's chip is the default, which is what a page
    // of the panel's width wants.
    in property <length> chip_w: FlipperTheme.drop_chip_w;

    DropLine {
        line: root.line;
        chip_w: root.chip_w;
    }

    // The frame around the picked row: a one-pixel outline and its shadow, which is what
    // `SelectorFrame` draws and what a page used to draw for itself.
    //
    // Its height is the framework's own selector height, and its width is the page less the
    // two columns it keeps clear at either edge - the same relationship `DropLine` keeps
    // between its row and the window.
    if root.line.selected: SelectorFrame {
        // The frame sits on the row's own top, and the chip inside it at `drop_top_pad`:
        // the relationship `DropLine` keeps, and the one the app's own pages draw with.
        x: FlipperTheme.drop_selector_x;
        y: root.line.y;
        frame_w: root.width - 2 * FlipperTheme.drop_selector_x;
        frame_h: FlipperTheme.drop_selector_h;
        // Radius left to the component's default, which is the selector's own token.
        filled: false;
        stroke: true;
        shadow: true;
    }
}
