# The hardware a hosted app may drive, opened to the groups flipctl.service runs
# with. The gpio group is made by flipctl.sysusers.conf.
SUBSYSTEM=="gpio", KERNEL=="gpiochip[0-9]*", GROUP="gpio", MODE="0660"
SUBSYSTEM=="spidev", KERNEL=="spidev*", GROUP="gpio", MODE="0660"
# No USB devices: an app reaches one only through a claim (claim.rs), whose root script
# hands that one node to the app's user.

# The four RGB LEDs flipctl draws (net_leds.rs): trigger, level and colour, to the
# leds group. They are attributes rather than nodes, which GROUP and MODE do not reach.
SUBSYSTEM=="leds", KERNEL=="flipper-one:rgb:*", ACTION=="add|change", \
  RUN+="/usr/bin/chgrp leds /sys%p/trigger /sys%p/brightness /sys%p/multi_intensity", \
  RUN+="/usr/bin/chmod g+w /sys%p/trigger /sys%p/brightness /sys%p/multi_intensity"
