[Unit]
Description=flipctl on the Flipper One panel
After=systemd-logind.service
Wants=systemd-logind.service
# Claim the panel before any display manager wakes up and starts looking at cards.
Before=display-manager.service
Before=sddm.service
Conflicts=cog-seat1.service

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=input video render

# A real login session, so logind gives this process seat1's devices: the SPI panel
# and the Flipper's buttons, both tagged ID_SEAT=seat1 by 72-seat-cog.rules.
PAMName=login
Environment=XDG_SEAT=seat1
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_TYPE=tty
# /usr/games too, because that is where Debian puts them and a hosted app is
# whatever the archive ships.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/games

DevicePolicy=closed
# The panel, by path rather than by number: card numbers move between kernels. The
# render node is for the apps' compositors, which draw with the GPU inside their own
# cage and hand us the result.
DeviceAllow=/dev/dri/by-path/platform-2acf0000.spi-cs-0-card rw
DeviceAllow=/dev/dri/by-path/platform-27800000.gpu-render rw
DeviceAllow=char-input rw
DeviceAllow=/dev/tty0 rw
# The kernel log, where flipctl puts the moment the panel lights up. It writes the node
# through sudo, as it does every privileged thing, but the cgroup's device filter applies to
# that child as much as to us, so without this line the write fails however root it is.
DeviceAllow=/dev/kmsg rw

# The installed layout, not a build tree: the binary is /usr/bin/flipctl and its
# apps and assets are under /usr/share/flipctl. A deploy installs over those paths
# and restarts this unit, so there is one flipctl on the machine and one place it
# runs from.
WorkingDirectory=/usr/share/flipctl
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/flipctl --panel \
    --remote 0.0.0.0:8899 --assets /usr/share/flipctl/assets/remote

# Stopping the unit does not stop what it started: PAMName=login puts these
# processes in a logind session scope rather than the service's own cgroup, so a
# restart used to leave the previous flipctl alive, still holding the remote view's
# port, and the
# new one came up with no endpoint for Back or the app switcher.
#
# sway covers the hosted apps: it is the parent of every one of them, so killing it
# takes the cages, the terminals and the games with it.
ExecStopPost=-/usr/bin/pkill -x flipctl
ExecStopPost=-/usr/bin/pkill -x sway
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
