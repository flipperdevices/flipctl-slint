[Unit]
Description=flipctl on the Flipper One panel
# The user's runtime directory, /run/user/1000, where flipctl keeps its socket, sway's
# and each app's directory, and finds PipeWire. Not a login session: opening one waits
# for user@1000.service, which waits for the network, 1.3s at boot. This unit makes the
# directory without waiting. 1000 is the image's user; a unit cannot name a uid.
Wants=user-runtime-dir@1000.service
After=user-runtime-dir@1000.service
# Claim the panel before any display manager wakes up and starts looking at cards.
Before=display-manager.service
Before=sddm.service
Conflicts=cog-seat1.service

[Service]
Type=simple
User=user
Group=user
# video and render for the panel's card and the GPU, input for the buttons, dialout
# for ttyUSB and ttyACM (the default udev rules), i2c for /dev/i2c-*, gpio for
# gpiochip and spidev, leds for the network LEDs
# (70-flipctl-devices.rules; both groups come from flipctl.sysusers.conf).
SupplementaryGroups=input video render dialout i2c gpio leds

# What a session would have set. The directory and the user's bus outlive any
# login because the image lingers the user, which also starts PipeWire at boot.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# /usr/games too, because that is where Debian puts them and a hosted app is
# whatever the archive ships.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/games

# The installed layout, not a build tree: the binary is /usr/bin/flipctl and its
# apps and assets are under /usr/share/flipctl. A deploy installs over those paths
# and restarts this unit, so there is one flipctl on the machine and one place it
# runs from.
WorkingDirectory=/usr/share/flipctl
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/flipctl --panel \
    --remote [::]:8899 --assets /usr/share/flipctl/assets/remote
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
